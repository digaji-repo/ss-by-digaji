# DropRoom Environment Configuration
APP_ENV=development
SERVER_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL / MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=droproom
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=droproom

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Auth
TOKEN_SECRET=replace-with-32-byte-random-secret
COOKIE_SECURE=false

# Storage & Limits
STORAGE_ROOT=./storage
MAX_FILE_SIZE_BYTES=104857600
DEFAULT_STORAGE_LIMIT_BYTES=524288000
MAX_PASTE_SIZE_BYTES=2097152

# Background Worker & Retention
CLEANUP_INTERVAL_SECONDS=10
EXPIRING_WARNING_MINUTES=5
EXPIRED_TOMBSTONE_RETENTION_HOURS=24
CHUNK_UPLOAD_TTL_HOURS=2

# Rate Limiting, Concurrency & Bandwidth
RATE_LIMIT_REQUESTS_PER_MIN=120
RL_CREATE_ROOM_PER_MIN=5
RL_JOIN_ROOM_PER_MIN=60
RL_ROOM_PROBE_404_PER_MIN=15
RL_VALIDATE_PW_PER_MIN_ROOM=30
RL_WS_HANDSHAKE_PER_MIN=15
MAX_CONCURRENT_UPLOADS_PER_IP=5
MAX_CONCURRENT_DOWNLOADS_PER_IP=4
DOWNLOAD_BANDWIDTH_KBPS=5120
MAX_WS_PER_IP=5
MAX_WS_PER_ROOM=50
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCKOUT_SECONDS=300

# Malware Scanning (ClamAV) & Parser Limits
CLAMAV_ENABLED=false
CLAMAV_ADDR=127.0.0.1:3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_FAIL_OPEN=false
MAX_PREVIEW_BYTES=26214400
MAX_DOCX_UNCOMPRESSED_BYTES=31457280
