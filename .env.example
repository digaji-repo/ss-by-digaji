# DropRoom Environment Configuration
APP_ENV=development
SERVER_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL / MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=droproom
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=droproom

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Auth
TOKEN_SECRET=replace-with-32-byte-random-secret
COOKIE_SECURE=false

# Storage & Limits
STORAGE_ROOT=./storage
MAX_FILE_SIZE_BYTES=104857600
DEFAULT_STORAGE_LIMIT_BYTES=524288000
MAX_PASTE_SIZE_BYTES=2097152

# Background Worker & Retention
CLEANUP_INTERVAL_SECONDS=10
EXPIRING_WARNING_MINUTES=5
EXPIRED_TOMBSTONE_RETENTION_HOURS=24
CHUNK_UPLOAD_TTL_HOURS=2

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MIN=120
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCKOUT_SECONDS=300
